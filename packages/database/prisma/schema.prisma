// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enumerations
// ─────────────────────────────────────────────

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum ContentType {
  IMAGE
  VIDEO
  TEXT
  WEB
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  password   String   // bcrypt hashed
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model Device {
  id         String        @id @default(uuid())
  nama       String
  lokasi     String
  status     DeviceStatus  @default(OFFLINE)
  last_seen  DateTime?
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  playlists  Playlist[]

  @@map("devices")
}

model Content {
  id         String       @id @default(uuid())
  judul      String
  tipe       ContentType
  payload    String       // URL for IMAGE/VIDEO/WEB, raw text for TEXT
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  playlists  Playlist[]

  @@map("contents")
}

/// Join table: Device <-> Content with ordering and duration metadata
model Playlist {
  id         String   @id @default(uuid())
  device_id  String
  content_id String
  urutan     Int      @default(0)  // display order within device playlist
  durasi     Int      @default(30) // display duration in seconds
  created_at DateTime @default(now())

  device  Device  @relation(fields: [device_id], references: [id], onDelete: Cascade)
  content Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([device_id, content_id])
  @@map("playlists")
}
