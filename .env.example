# Root .env.example — see individual app .env.example files for app-specific vars

# ─── Database (Local Docker) ──────────────────────────────
# Use this if running local postgres via docker-compose
DATABASE_URL="postgresql://signage:signage_dev_password@localhost:5432/signage_db"
DIRECT_URL="postgresql://signage:signage_dev_password@localhost:5432/signage_db"

# ─── Database (Supabase) ──────────────────────────────────
# Uncomment and fill when using Supabase:
# DATABASE_URL="postgresql://postgres.[ref]:[pass]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[pass]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ─── Admin ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ─── Client Device ────────────────────────────────────────
VITE_SERVER_URL=http://localhost:4000
